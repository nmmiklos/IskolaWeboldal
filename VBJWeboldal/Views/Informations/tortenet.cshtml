@{
    ViewData["Title"] = "Iskolánk története";
}

<section class="hero hero-info">
    <div class="hero-left">
        <span class="hero-kicker">Múltunk</span>
        <h2>Iskolánk története</h2>
        <p>
            Rövid áttekintés intézményünk fejlődéséről és legfontosabb mérföldköveiről.
        </p>
    </div>

    <div class="hero-right">
        <div class="hero-card">
            <div class="hero-illustration" style="background: url('/wwwroot/rootimages/logo2.jpg') center/cover no-repeat;">
            </div>
        </div>
    </div>
</section>

<div class="grid">
    <div>


        <section class="section">
            <div class="section-h">
                <h3>Bevezetés</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">
                <p>
                    Iskolánk története több mint fél évszázadra nyúlik vissza.
                    A fejlődés mögött mindig a város és a gazdaság igényei álltak,
                    amelyek új képzések és intézményi bővítések létrejöttét indokolták.
                </p>

                <p>
                    A kezdetekhez egészen 1961-ig kell visszanyúlnunk.
                </p>
            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Kezdetek (1960-as évek)</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">
                <p>
                    A mezőgazdasági jellegű városban ipari üzemek jelentek meg,
                    ami megnövelte a szakemberek iránti igényt.
                </p>

                <p>
                    1962–63-ban elindult a mechanikai műszerész képzés,
                    majd 1964–65-ben az elektroműszerész szak is.
                </p>

                <p>
                    A diákok érettségit és szakmunkás bizonyítványt is szerezhettek,
                    ami akkoriban kiemelkedő lehetőség volt.
                </p>
            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Fejlődés és bővülés (1970–1990)</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">
                <p>
                    A növekvő létszám miatt új iskolaépület épült,
                    amely 1970-re készült el.
                </p>

                <p>
                    1971-ben a teljes intézmény elkészült tornateremmel együtt,
                    majd 1975-ben kollégium is épült.
                </p>

                <p>
                    1987–88-ban létrejött a „C” épület,
                    ahol már számítástechnikai oktatás folyt.
                </p>
            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Új képzések és irányok</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">
                <p>
                    1990–91-ben elindult a gépgyártástechnológia–számítástechnika szak.
                </p>

                <p>
                    1994–95-től közgazdasági képzés is megjelent,
                    alkalmazkodva a munkaerőpiac változásaihoz.
                </p>

                <p>
                    Az intézmény neve ennek megfelelően módosult,
                    tükrözve a műszaki és gazdasági képzések együttes jelenlétét.
                </p>
            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Modern korszak</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">
                <p>
                    2011-től az intézmény fenntartója az Egri Főegyházmegye lett.
                </p>

                <p>
                    2016-tól szakgimnáziumként működött tovább,
                    majd 2020-ban felvette jelenlegi nevét:
                </p>

                <p style="font-weight:700;">
                    Vak Bottyán János Katolikus Műszaki és Közgazdasági Technikum,
                    Gimnázium és Kollégium
                </p>

                <p>
                    Az iskola ma is folyamatosan fejlődik,
                    alkalmazkodva a modern oktatási és gazdasági kihívásokhoz.
                </p>
            </div>
        </section>

    </div>

    <aside class="side">

        <div class="box">
            <div class="box-h">
                <h4>Mérföldkövek</h4>
            </div>
            <div class="box-body">

                <div class="info-card">1962 – első szak indul</div>
                <div class="info-card">1970 – új épület</div>
                <div class="info-card">1987 – informatika</div>
                <div class="info-card">1994 – közgazdaság</div>
                <div class="info-card">2011 – egyházi fenntartás</div>
                <div class="info-card">2020 – technikum</div>

            </div>
        </div>

    </aside>
</div>