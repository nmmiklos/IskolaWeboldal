@{
    ViewData["Title"] = "Vak Bottyán János";
}

<section class="hero hero-gepeszet">
    <div class="hero-left">
        <span class="hero-kicker">Iskolánk névadója</span>
        <h2>Vak Bottyán János</h2>
        <p>
            A Rákóczi-szabadságharc legendás hadvezére, akinek neve összeforrt a bátorsággal és hűséggel.
        </p>
    </div>

    <div class="hero-right">
        <div class="hero-card">
            <div class="hero-illustration" style="background: url('/wwwroot/rootimages/Vak-Bottyán-János.png') center/cover no-repeat;">
            </div>
        </div>
    </div>
</section>

<div class="grid">
    <div>

        <section class="section">
            <div class="section-h">
                <h3>Élete</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">

                <p>
                    Vak Bottyán János (1640 körül – 1709) elszegényedett protestáns kisnemesi családból származott.
                    Születési éve bizonytalan, legvalószínűbb az 1643–1644 közötti időszak.
                </p>

                <p>
                    1669-ben Lakatos Juditot vette feleségül, akinek révén jelentős vagyonra tett szert.
                    Később, 1707-ben újra megnősült, Forgách Juliannát vette el,
                    ezzel az arisztokrácia is befogadta.
                </p>

                <p>
                    Fiatalon a nagyszombati jezsuiták birtokán dolgozott,
                    majd katonai pályára lépett.
                </p>

            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Katonai pályafutása</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">

                <p>
                    1665 után, Érsekújvár török kézre kerülésével katonának állt.
                    Bátorságával gyorsan kitűnt, és hadnagyi rangig jutott.
                </p>

                <p>
                    Egy legenda szerint bejutott a törökök által őrzött Érsekújvárba,
                    és a mecsetből ledobta a müezzint, majd sikeresen elmenekült.
                </p>

                <p>
                    Részt vett Esztergom visszafoglalásában, majd a város parancsnoka lett.
                    Később a török elleni harcokban ezredesi rangig emelkedett.
                </p>

                <p>
                    Egy csatában elvesztette egyik szemét,
                    innen ered a „Vak Bottyán” elnevezés.
                </p>

            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Labancból kuruc</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">

                <p>
                    A Rákóczi-szabadságharc idején először a császári oldalon harcolt,
                    majd a kurucokhoz csatlakozott és hűséget esküdött II. Rákóczi Ferencnek.
                </p>

                <p>
                    1704-ben bevette Érsekújvárat, és a vár főkapitánya lett.
                    Számos hadjáratban vett részt, Morvaországba is betört.
                </p>

                <p>
                    A Dunántúl kormányzójaként sikeresen védte a területet,
                    hadvezéri képességeit még ellenfelei is elismerték.
                </p>

                <p>
                    Több csatában is túlerővel szemben győzött,
                    és kulcsszerepet játszott a szabadságharcban.
                </p>

            </div>
        </section>

        <section class="section" style="margin-top:12px;">
            <div class="section-h">
                <h3>Halála és öröksége</h3>
            </div>

            <div style="padding:16px; line-height:1.65; font-size:14px;">

                <p>
                    1709 szeptemberében hunyt el a Tarnaörs melletti táborban.
                    Halálát valószínűleg nem pestis, hanem agyhártyagyulladás okozta.
                </p>

                <p>
                    Gyöngyösön temették el a ferences templomban,
                    katonai tiszteletadás mellett.
                </p>

                <p style="font-weight:700;">
                    Jelentőségét mutatja, hogy a legendás hadvezér
                    győzhetetlennek számított.
                </p>

            </div>
        </section>

    </div>

    <aside class="side">

        <div class="box">
            <div class="box-h">
                <h4>Gyors adatok</h4>
            </div>
            <div class="box-body">

                <div class="info-card">Születés: ~1640</div>
                <div class="info-card">Katona, hadvezér</div>
                <div class="info-card">„Vak Bottyán”</div>
                <div class="info-card">Rákóczi híve</div>
                <div class="info-card">Halál: 1709</div>

            </div>
        </div>

    </aside>
</div>